# Copy to .env and fill in. Never commit .env.

# Crypto.com EXCHANGE API key (created at crypto.com/exchange -> Settings -> API Keys).
# Leave both empty to run a dry run that only uses public market data.
CRYPTO_COM_API_KEY=
CRYPTO_COM_API_SECRET=

# Dry run is ON unless this is exactly false/0/no/off.
DRY_RUN=true

# What to trade: any coin listed against USD on the Crypto.com Exchange (trades <SYMBOL>_USD).
SYMBOL=USDU
# BUY or SELL.
SIDE=BUY

# Each run trades a random USD amount between $0 and a price-scaled maximum:
# MAX_AMOUNT_USD when the price is at or better than FULL_PRICE, shrinking
# linearly to $0 at NO_TRADE_PRICE. Better = lower for BUY, higher for SELL, so
#   BUY:  FULL_PRICE < NO_TRADE_PRICE  (buy more the cheaper it gets)
#   SELL: FULL_PRICE > NO_TRADE_PRICE  (sell more the higher it gets)
# Amounts under MIN_AMOUNT_USD are rerolled; keep it above the exchange's $1 minimum.
MIN_AMOUNT_USD=2
MAX_AMOUNT_USD=20
FULL_PRICE=0.995
NO_TRADE_PRICE=1.000

# Maximum USD traded per local calendar day (counted per SYMBOL and SIDE).
DAILY_LIMIT_USD=50

# Optional overrides
# CRYPTO_COM_BASE_URL=https://api.crypto.com/exchange/v1
# TRADES_CSV=trades.csv
# REQUEST_TIMEOUT_SECONDS=10
# ORDER_STATUS_TIMEOUT_SECONDS=30
