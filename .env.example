# Copy to .env and fill in. Never commit .env.

# Crypto.com EXCHANGE API key (created at crypto.com/exchange -> Settings -> API Keys).
# Leave both empty to run a dry run that only uses public market data.
CRYPTO_COM_API_KEY=
CRYPTO_COM_API_SECRET=

# Dry run is ON unless this is exactly false/0/no/off.
DRY_RUN=true

# Maximum USD spent on USDU_USD buys per local calendar day.
DAILY_LIMIT_USD=50

# Optional overrides
# CRYPTO_COM_BASE_URL=https://api.crypto.com/exchange/v1
# TRADES_CSV=trades.csv
# REQUEST_TIMEOUT_SECONDS=10
# ORDER_STATUS_TIMEOUT_SECONDS=30
